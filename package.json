{
  "name": "kaywalker91-portfolio",
  "version": "1.0.0",
  "description": "Portfolio website for Flutter developer - Playwright QA automation",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "playwright:install": "playwright install chromium --with-deps",
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.input.css -o css/tailwind.css --minify"
  },
  "keywords": [
    "portfolio",
    "playwright",
    "qa",
    "automation"
  ],
  "author": "Daegak Kim",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "tailwindcss": "3.4.19"
  }
}
